# Copy this file to ".env" in the same folder. The .env file is never committed.

# The Neon project the service is deployed to (the same one as the usage counter).
NEON_PROJECT_ID=

# The key the optimiser uses to create reviews and fetch results. Long and random,
# at least 32 characters, letters and numbers only. Never give it to a reviewer.
REVIEW_ADMIN_KEY=

# Filled in by deploy.mjs: the address of the deployed service.
REVIEW_ADDRESS=

# For local.mjs and test-db.mjs only. Neon gives it to a deployed function by itself.
DATABASE_URL=
