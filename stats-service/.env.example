# Settings for the usage counter. Copy to .env (which git ignores) and fill in.

# The addresses the tool is served from, separated by commas. Counts from anywhere
# else are ignored. No trailing slash.
ALLOWED_ORIGINS=https://bestbit2000.github.io

# The key that opens the totals page. Make it long and random. Leave empty to
# switch the totals page off.
STATS_KEY=

# Only needed by deploy.mjs: the Neon project the counter lives in.
NEON_PROJECT_ID=

# Only needed when running local.mjs or test-db.mjs. Neon supplies it to a deployed function.
DATABASE_URL=

# Optional: a different table name, for testing without touching the real counts.
STATS_TABLE=
